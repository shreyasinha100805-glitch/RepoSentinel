PORT=5000

# Google AI & Agent Framework (Hackathon Mandatory: Gemini 3.5 + Google ADK)
GEMINI_MODEL=gemini-3.5-flash
GEMMA_MODEL=gemma-2-9b-it
GEMINI_API_KEY=

# Google Cloud Services (Cloud Run, Firestore, Pub/Sub)
GOOGLE_CLOUD_PROJECT=demo-project
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC=reposentinel-scans

# MongoDB Persistence
# Set DEMO_MODE=false and provide this URI to persist scan history in MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reposentinel
MONGODB_COLLECTION=scans
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_RETRY_INTERVAL_MS=30000

# GitHub Integration
GITHUB_TOKEN=

# Demo Mode Configuration
DEMO_MODE=true
